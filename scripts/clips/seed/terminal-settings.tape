# Shared look of the terminal scenes, prepended to each by record.sh: the
# site's dark colours, 22 px text.
Set Shell bash
Set FontFamily "DejaVu Sans Mono"
Set FontSize 22
Set LineHeight 1.3
Set Width 1440
Set Height 900
Set Margin 32
Set MarginFill "#15120f"
Set WindowBar Colorful
Set WindowBarSize 40
Set BorderRadius 10
Set Padding 28
Set Framerate 30
Set TypingSpeed 32ms
Set CursorBlink false
Set Theme { "name": "Ink", "black": "#15120f", "red": "#f87e77", "green": "#83d494", "yellow": "#e8c37a", "blue": "#8ec5ec", "magenta": "#c9a2e8", "cyan": "#8ed4cf", "white": "#efebe2", "brightBlack": "#857f79", "brightRed": "#f87e77", "brightGreen": "#83d494", "brightYellow": "#f0d08f", "brightBlue": "#a6d3f2", "brightMagenta": "#d6b6ef", "brightCyan": "#a5e0db", "brightWhite": "#ffffff", "background": "#1c1916", "foreground": "#efebe2", "selection": "#413c38", "cursor": "#f97316" }
