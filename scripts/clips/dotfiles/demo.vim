" Minimal Neovim look for the clip: the terminal's own background, line numbers, no plugins.
set termguicolors nowrap number noshowmode laststatus=0 noruler shortmess+=I
highlight Normal guibg=NONE guifg=#efebe2
highlight LineNr guifg=#6b655c
highlight Visual guibg=#3a342d
highlight NonText guifg=#15120f
