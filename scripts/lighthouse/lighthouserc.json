{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:48421/",
        "http://127.0.0.1:48421/about",
        "http://127.0.0.1:48421/how-i-work",
        "http://127.0.0.1:48421/work/smartlite",
        "http://127.0.0.1:48421/tools/mig",
        "http://127.0.0.1:48421/blog",
        "http://127.0.0.1:48421/blog/zond-sso-probe-bridge",
        "http://127.0.0.1:48421/blog/opus-5-5-vs-sonnet-5-agent-costs",
        "http://127.0.0.1:48421/blog/trail-code-claude-code-test"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox --disable-dev-shm-usage",
        "disableFullPageScreenshot": true,
        "blockedUrlPatterns": [
          "*/umami/*"
        ]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95,
            "aggregationMethod": "median"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "median"
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "median"
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "median"
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
