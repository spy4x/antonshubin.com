{
  "nodeModulesDir": "manual",
  "minimumDependencyAge": { "age": "1440", "exclude": ["jsr:@spy4x/*"] },
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check && deno task test && deno task test:browser",
    "test": "deno task build && deno test --allow-env --allow-read --allow-write --allow-net=127.0.0.1,0.0.0.0 --allow-run=deno --ignore=test/lead-form.browser.test.ts,test/a11y.browser.test.ts,test/contrast.browser.test.ts,test/csp.browser.test.ts,test/sw-retired.browser.test.ts,test/visual-system.browser.test.ts,test/notes.browser.test.ts,test/meet-embed.browser.test.ts,test/blog-overflow.browser.test.ts,test/safe-area.browser.test.ts,test/lightbox-fit.browser.test.ts,test/frame.browser.test.ts,test/copy.browser.test.ts,test/analytics.browser.test.ts,test/card-links.browser.test.ts",
    "test:browser": "deno test -A test/lead-form.browser.test.ts test/a11y.browser.test.ts test/contrast.browser.test.ts test/csp.browser.test.ts test/sw-retired.browser.test.ts test/visual-system.browser.test.ts test/notes.browser.test.ts test/meet-embed.browser.test.ts test/blog-overflow.browser.test.ts test/safe-area.browser.test.ts test/lightbox-fit.browser.test.ts test/frame.browser.test.ts test/copy.browser.test.ts test/analytics.browser.test.ts test/card-links.browser.test.ts",
    "dev": "vite",
    "build": "vite build",
    "start": "deno serve -A _fresh/server.js",
    "update": "deno run -A -r jsr:@fresh/update .",
    "deploy": "deno run -A scripts/deploy.ts",
    "deploy:stag": "DEPLOY_ENV=staging deno run -A scripts/deploy.ts",
    "env:encrypt": "deno run --node-modules-dir=none --no-prompt -R -W=. jsr:@spy4x/server@1.2.0/env-age64/cli encrypt",
    "env:decrypt": "deno run --node-modules-dir=none --no-prompt -R -W=. jsr:@spy4x/server@1.2.0/env-age64/cli decrypt",
    "env:status": "deno run --node-modules-dir=none --no-prompt -R -W=. jsr:@spy4x/server@1.2.0/env-age64/cli status",
    "publish:blog": "deno run -A scripts/publish-blog.ts",
    "launch-kit": "deno run -A scripts/launch-kit.ts",
    "video-kit": "deno run -A scripts/video-kit.ts",
    "links": "deno run -R --allow-env scripts/links.ts",
    "weekly-numbers": "deno run -A scripts/weekly-numbers.ts",
    "umami-reports": "deno run --allow-env --allow-net scripts/umami-reports.ts",
    "optimize:screenshots": "deno run -A scripts/optimize-screenshots.ts",
    "lcp": "deno run -A scripts/lcp.ts",
    "og": "deno run -A scripts/og-images.ts",
    "social-preview": "deno task build && deno run -A scripts/og-images.ts --social",
    "strip-metadata": "deno run --allow-read --allow-write --allow-run=git scripts/strip-metadata.ts"
  },
  "lint": {
    "rules": {
      "tags": ["fresh", "recommended"],
      "exclude": ["react-no-danger"]
    }
  },
  "exclude": ["**/_fresh/*", "launches/**", "videos/**"],
  "imports": {
    "@/": "./",
    "@spy4x/email": "jsr:@spy4x/email@1.26.0",
    "@spy4x/integrations": "jsr:@spy4x/integrations@1.19.0",
    "@spy4x/net": "jsr:@spy4x/net@1.19.0",
    "@spy4x/platform": "jsr:@spy4x/platform@1.19.0",
    "@spy4x/preact-charts": "jsr:@spy4x/preact-charts@2.0.0",
    "@spy4x/preact-cn": "jsr:@spy4x/preact-cn@2.0.0",
    "@spy4x/preact-crud": "jsr:@spy4x/preact-crud@2.0.0",
    "@spy4x/preact-icons": "jsr:@spy4x/preact-icons@2.0.0",
    "@spy4x/preact-map": "jsr:@spy4x/preact-map@2.0.0",
    "@spy4x/preact-signals": "jsr:@spy4x/preact-signals@2.0.0",
    "@spy4x/preact-system": "jsr:@spy4x/preact-system@2.0.0",
    "@spy4x/preact-theme": "jsr:@spy4x/preact-theme@2.0.0",
    "@spy4x/preact-ui": "jsr:@spy4x/preact-ui@2.0.0",
    "@spy4x/preact-ui-guide": "jsr:@spy4x/preact-ui-guide@2.0.0",
    "@spy4x/server": "jsr:@spy4x/server@1.19.0",
    "@spy4x/time": "jsr:@spy4x/time@1.19.0",
    "@std/front-matter": "jsr:@std/front-matter@^1.0.9",
    "@std/net": "jsr:@std/net@^1.0.6",
    "@std/path": "jsr:@std/path@^1.1.2",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.18",
    "arktype": "npm:arktype@2.2.3",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "marked": "npm:marked@^17.0.1",
    "preact": "npm:preact@^10.29.1",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.0.8",
    "tailwindcss": "npm:tailwindcss@^4.1.18",
    "vite": "npm:vite@^7.1.3",
    "playwright": "npm:playwright@1.63.0",
    "axe-core": "npm:axe-core@4.13.0"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.asynciterable", "dom.iterable", "deno.ns"],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": ["vite/client"]
  }
}
